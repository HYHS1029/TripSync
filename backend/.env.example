DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DATABASE_NAME
# Neon: use the pooled URL above; migrations can use a separate direct URL.
MIGRATION_DATABASE_URL=
# Explicit origins only; Vercel's server requests do not need browser CORS access.
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
# Generate a unique key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Origin of the frontend, used to construct trusted email links. HTTPS outside localhost.
FRONTEND_URL=http://localhost:3000
# Keep disabled for the friends-only preview; SMTP alone does not enable it.
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_EXPIRE_MINUTES=30
# Local inbox: docker compose --profile mail up -d mailpit
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURITY=none
# Production SMTP_SECURITY: starttls (usually 587) or ssl (usually 465).
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@tripsync.example
# Server-only key: enable Places API (New) and Routes API; restrict its APIs/source.
# Development can use a Maps Demo Key without a billing account.
GOOGLE_MAPS_API_KEY=
