NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional server-only URL for Next.js authentication requests.
API_BASE_URL=http://localhost:8000
# Browser key: enable Maps JavaScript API and restrict HTTP referrers/API scope.
# Development can use a Maps Demo Key; the current demo was verified with no-referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# DEMO_MAP_ID works for local development; use your own map ID in production.
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID
